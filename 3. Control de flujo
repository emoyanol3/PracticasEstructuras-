#Ejercicio 6 ¿es primo? Verificar si un número es primo (Optimizado para números grandes)

# Entrada: n (número entero a evaluar)
# Proceso: Recorrer desde 2 hasta la raíz cuadrada de n (√n); si encuentra divisor corta con break
# Salida: Presentar si el número es primo o no

# Bosquejo (Prueba para n = 101 -> √101 ≈ 10, revisa del 2 al 10)
# i = 2: 101 % 2 != 0
# i = 3: 101 % 3 != 0
# ...
# i = 10: 101 % 10 != 0 -> Fin del rango sin divisores
# Resultado: 101 es primo

# Patrón
# Búsqueda con límite matemático (Optimizada con √n e interrupción temprana break)

n = int(input("Número: "))
es_primo = True

if n < 2:
    es_primo = False
else:
    # int(n ** 0.5) + 1 limita las pruebas solo hasta la raíz cuadrada de n
    for i in range(2, int(n ** 0.5) + 1):
        if n % i == 0:
            es_primo = False
            break

if es_primo:
    print(f"{n} es primo")
else:
    print(f"{n} NO es primo")




