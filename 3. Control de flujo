# Patrón
# Generación de Serie Recurrente / Actualización Simultánea de Variables

n = int(input("¿Cuántos? "))
a, b = 0, 1                         # Asignación múltiple para los valores iniciales

for _ in range(n):                  # _ indica que no se requiere utilizar la variable del ciclo
    print(a, end=" ")
    a, b = b, a + b                 # Avanza la serie calculando el siguiente término

print()                             # Salto de línea final
  





