# Ejercicio P3: Verificar si un año es bisiesto (Versión extendida y compacta)

# Entrada: anio (número entero a evaluar) y lista de prueba [2024, 2023, 2000, 1900]
# Proceso: Evaluar divisibilidad por 400, 100 y 4 (divisibles por 4 pero no por 100, excepto los múltiplos de 400)
# Salida: Presentar el año junto con un valor booleano (True/False) indicando si es bisiesto

# Bosquejo (Prueba para y = 2000 y y = 1900 en es_bisiesto_corta)
# y = 2000: 2000 % 400 == 0 es Verdadero -> Retorna True inmediatamente
# y = 1900: 1900 % 400 == 0 (Falso) or (1900 % 4 == 0 (Verdadero) and 1900 % 100 != 0 (Falso)) -> Retorna False
# Resultado: 2000: True, 1900: False

# Patrón
# Salidas Tempranas (Early Exit) / Evaluación Booleana Compuesta para Reglas de Excepción

def es_bisiesto(anio):
    if anio % 400 == 0:
        return True                # Los múltiplos de 400 siempre son bisiestos
    if anio % 100 == 0:
        return False               # El resto de múltiplos de 100 NO son bisiestos
    if anio % 4 == 0:
        return True                # Múltiplos de 4 (no múltiplos de 100) son bisiestos
    return False                   # Cualquier otro año NO es bisiesto

# O en una línea:
def es_bisiesto_corta(anio):
    return anio % 400 == 0 or (anio % 4 == 0 and anio % 100 != 0)

# Pruebas
for y in [2024, 2023, 2000, 1900]:
    print(f"{y}: {es_bisiesto_corta(y)}")





# Ejercicio P4:  Cálculo de Factorial y Combinatoria (Combinaciones sin repetición)

# Entrada: n (total de elementos) y k (elementos a seleccionar)
# Proceso: Multiplicar enteros de 2 a n para el factorial; aplicar la fórmula n! / (k! * (n-k)!) mediante división entera
# Salida: Presentar el factorial de n y el número total de combinaciones posibles

# Bosquejo (Prueba para combinatoria(5, 2))
# factorial(5) = 1 * 2 * 3 * 4 * 5 = 120
# factorial(2) = 1 * 2 = 2
# factorial(5 - 2) = factorial(3) = 1 * 2 * 3 = 6
# combinatoria(5, 2) = 120 // (2 * 6) = 120 // 12 = 10
# Resultado esperado: 120 para factorial(5) y 10 para combinatoria(5, 2)

# Patrón
# Modularización Matemática Compuesta (Composición de Funciones / Producto Acumulado)

def factorial(n):
    fact = 1
    for i in range(2, n + 1):
        fact *= i                   # Acumula la multiplicación iterativa de 2 hasta n
    return fact

def combinatoria(n, k):
    # Utiliza la función factorial() para resolver la fórmula combinatoria: n! / (k! * (n - k)!)
    return factorial(n) // (factorial(k) * factorial(n - k))

# Uso
print(factorial(5))             # Muestra el resultado de 5! (1 * 2 * 3 * 4 * 5 = 120)
print(combinatoria(5, 2))       # Calcula las combinaciones de 5 elementos tomados de 2 en 2 (Resultado: 10)


















# Ejercicio P5: Calculadora modular

# Entrada: opcion (menú de selección) y n1, n2 (operandos ingresados condicionalmente)
# Proceso: Despachar la operación matemática según la opción elegida mediante funciones independientes
# Salida: Presentar el resultado de la operación formateado o el mensaje de cierre de programa

# Bosquejo (Prueba para opción 1 con n1=4 y n2=2, luego opción 5)
# Iteración 1: opcion = 1 -> pide n1=4, n2=2 -> suma(4, 2) -> "4.0 + 2.0: 6.0"
# Iteración 2: opcion = 5 -> imprime "Vuelve pronto!" -> break (sale sin pedir números)

# Patrón
# Despacho Aislado por Menú (Lectura condicional de parámetros según el flujo de la opción)

def suma(n1, n2):
    return f"{n1} + {n2}: {n1 + n2}"

def resta(n1, n2):
    return f"{n1} - {n2}: {n1 - n2}"

def multiplicacion(n1, n2):
    return f"{n1} x {n2}: {n1 * n2}"

def division(n1, n2):
    if n2 == 0:
        return "Error: No se puede dividir entre cero"
    return f"{n1} / {n2}: {n1 / n2}"

def mostrar_calculadora():
    print("\n--- Operaciones ---")
    print("1. Sumar")
    print("2. Restar")
    print("3. Multiplicar")
    print("4. Dividir")
    print("5. Salir")

while True:
    mostrar_calculadora()
    opcion = int(input("Ingrese una opción: "))
    
    if opcion == 5:
        print("¡Vuelve pronto!")
        break                       # Sale directamente sin pedir números
    elif 1 <= opcion <= 4:
        n1 = float(input("Ingrese el primer número: "))
        n2 = float(input("Ingrese el segundo número: "))
        
        if opcion == 1:
            print(suma(n1, n2))
        elif opcion == 2:
            print(resta(n1, n2))
        elif opcion == 3:
            print(multiplicacion(n1, n2))
        elif opcion == 4:
            print(division(n1, n2))
    else:
        print("Opción inválida")



