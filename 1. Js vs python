  print("Has aprobado")
else:
  print ("Has reprobado")




#Ejercicio 3 area y perimetro de un rectangulo
#Leer la base y la altura de un rectángulo y mostrar su área y su perímetro. Recuerda: área = base × altura, perímetro = 2 × (base + altura). 
#Entrada: base, altura , Proceso: aplicar las dos fórmulas , Salida: area y perimetro

#Bosquejo
#base = 5, altura = 3
#área      = 5 × 3 = 15
#perímetro = 2 × (5 + 3) = 16
#Se leen los datos y se calculan independientemente las variables para luego presentarlas

base = float(input("Base: "))
altura = float(input("Altura: "))

area = base * altura                # PROCESO 1
perimetro = 2 * (base + altura)     # PROCESO 2

print(f"Área: {area:.2f}")
print(f"Perímetro: {perimetro:.2f}")



#Ejercicio adicional  área y perímetro de un círculo
#Leer el radio de un círculo y mostrar su área y su perímetro. Recuerda: área = π × r², perímetro = 2 × π × r. 
#Entrada: radio , Proceso: aplicar las dos fórmulas usando math.pi , Salida: area y perimetro

#Bosquejo
#radio = 5
#área     = π × 5² = 78.54
#perímetro = 2 × π × 5 = 31.42
#Se lee el dato y se calculan independientemente las variables para luego presentarlas

import math
radio = float(input("Radio: "))
area = math.pi * (radio ** 2)       # PROCESO 1
perimetro = 2 * math.pi * radio     # PROCESO 2

print(f"Área: {area:.2f}")
print(f"Perímetro: {perimetro:.2f}")



